# Required (single-account setup)
LOGGLY_SUBDOMAIN=your_subdomain
LOGGLY_TOKEN=your_loggly_token

# Optional
LOGGLY_AUTH_MODE=bearer
LOGGLY_MAX_RETRIES=2
LOGGLY_REQUEST_TIMEOUT_MS=15000
LOGGLY_LOG_LEVEL=info

# Optional: max concurrent requests per account (default 4). The aggregation tools
# (search_logs/traffic_by_*/get_ip_context) fan out several requests per call — this caps how
# many run at once against a given Loggly account so that fan-out doesn't trip Loggly's own
# per-account rate limit (429). Lower it if you still see 429s; raise it if Loggly's limit is
# more generous than the default assumes.
# LOGGLY_MAX_CONCURRENT_REQUESTS=4

# Optional: multi-account setup. When set, this replaces LOGGLY_SUBDOMAIN/LOGGLY_TOKEN/LOGGLY_AUTH_MODE above.
# Each tool call accepts an `account` argument matching one of these keys.
# LOGGLY_ACCOUNTS={"acme":{"subdomain":"acme","token":"acme_token","authMode":"bearer"},"beta":{"subdomain":"beta","token":"beta_token"}}

# Optional: which account name tools use when `account` is omitted (defaults to "default", or the
# only configured account if there is exactly one).
# LOGGLY_DEFAULT_ACCOUNT=acme

# Remote HTTP server only (src/http-server.js). Not used by the local stdio server (src/index.js).
# Required: shared secret org members send as `Authorization: Bearer <token>`.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_BEARER_TOKEN=

# Optional: port the HTTP server listens on (default 8787).
# MCP_HTTP_PORT=8787

# Optional: parsed-field names used by search_logs/traffic_by_*/group_by_*/get_ip_context.
# These depend on how each Loggly source parses its logs — verify with `list_fields` against
# real data before relying on the defaults below.
# LOGGLY_FIELD_IP=ip
# LOGGLY_FIELD_HOST=host
# LOGGLY_FIELD_PATH=path
# LOGGLY_FIELD_STATUS=status
# LOGGLY_FIELD_USER_AGENT=user_agent

# Optional: IP intelligence enrichment for get_ip_context / ip_reputation.
# RDAP (rdap_lookup) needs no key. Leave either of these unset to skip that source gracefully.
# GREYNOISE_API_KEY=
# ABUSEIPDB_API_KEY=
