{
  "name": "@andrewbabu/loggly-mcp",
  "version": "1.3.0",
  "description": "Read-only MCP server for Loggly search and analytics, with IP intelligence (RDAP, GreyNoise, AbuseIPDB).",
  "mcpName": "io.github.andrewbabu/loggly-mcp",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loggly-mcp": "src/index.js"
  },
  "files": [
    "src",
    "scripts",
    "tool-manifest.json",
    "examples",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewbabu/loggly-mcp.git"
  },
  "homepage": "https://github.com/andrewbabu/loggly-mcp#readme",
  "bugs": {
    "url": "https://github.com/andrewbabu/loggly-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "loggly",
    "logs",
    "observability",
    "ip-intelligence"
  ],
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http-server.js",
    "smoke": "node scripts/smoke-test.mjs",
    "verify:manifest": "node scripts/verify-tool-manifest.mjs",
    "test": "npm run verify:manifest && npm run smoke"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^3.23.8"
  }
}
